{
  "name": "debug-gym",
  "displayName": "Debug Gym",
  "description": "Test and submit Debug Gym v2 bug fixes from VS Code.",
  "version": "0.2.1",
  "publisher": "team-ok-itpd",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionDependencies": ["ms-python.python", "ms-python.debugpy"],
  "categories": ["Testing"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "debugGym.runTests",
        "title": "Test",
        "category": "Debug Gym",
        "icon": "$(beaker)"
      },
      {
        "command": "debugGym.runTest",
        "title": "Run This Test",
        "category": "Debug Gym",
        "icon": "$(play)"
      },
      {
        "command": "debugGym.submit",
        "title": "Submit",
        "category": "Debug Gym",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "debugGym.pullExercise",
        "title": "Pull Exercise with Code",
        "category": "Debug Gym",
        "icon": "$(cloud-download)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "debugGym",
          "title": "Debug Gym",
          "icon": "./media/debug-gym.svg"
        }
      ]
    },
    "views": {
      "debugGym": [
        {
          "id": "debugGym.results",
          "name": "Exercise"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "debugGym.results",
        "contents": "Start here: get a one-time code from your exercise page, then pull the exercise into VS Code.\n[Pull Exercise with Code](command:debugGym.pullExercise)\n[Test](command:debugGym.runTests)\n[Submit](command:debugGym.submit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "debugGym.pullExercise",
          "when": "view == debugGym.results",
          "group": "navigation@0"
        },
        {
          "command": "debugGym.runTests",
          "when": "view == debugGym.results",
          "group": "navigation@1"
        },
        {
          "command": "debugGym.submit",
          "when": "view == debugGym.results",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "debugGym.runTest",
          "when": "view == debugGym.results && viewItem == debugGymTest",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "debugGym.runTest",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Debug Gym",
      "properties": {
        "debugGym.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL of the Debug Gym website used to exchange exercise pairing codes."
        }
      }
    }
  }
}

DEBUG_GYM_CATALOG_PORT=3000
DEBUG_GYM_WORKSPACE_PORT=8080
DEBUG_GYM_WORKSPACE_URL=http://localhost:8080

# Telemetry. Leave empty locally: nothing is collected or exposed.
# Staging and production each use their own values; never commit real ones.
DEBUG_GYM_METRICS_TOKEN=
DEBUG_GYM_ANALYTICS_URL=
DEBUG_GYM_ANALYTICS_KEY=
# Keep `web` in local and production runs. Use `usability-test` only in staging
# during a scheduled dry run or counted usability session.
DEBUG_GYM_ANALYTICS_SOURCE=web
